# Server Environment Configuration
PORT=4000
NODE_ENV=development

# Cryptographic Keys (MUST BE CHANGED IN PRODUCTION TO MINIMUM 32 CHARACTERS HIGH ENTROPY)
JWT_SECRET=ft_prod_jwt_secret_high_entropy_secure_key_2026_ft_auth!
JWT_EXPIRES_IN=1h

# Dedicated Master Admin Key (Hashed on backend)
ADMIN_USERNAME=ft_master_admin
ADMIN_PASSWORD_HASH=$2b$12$7kP.LdZlOquu5eJzT7xI1e1h2uKk3U6m9S8k2O7r.pM0c8d1uQn5i

# Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/first_touch_db?schema=public"

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
